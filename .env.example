# Shared MPP challenge signing secret. Use at least 32 random bytes.
MPP_SECRET_KEY=replace-with-random-value

# Stripe SPT charge and SPT-funded streaming demo.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PROFILE_ID=internal
STRIPE_PAYMENT_METHOD=pm_card_visa
STRIPE_PAYMENT_METHOD_TYPES=card,link
MPP_AMOUNT=0.50
MPP_CURRENCY=usd
MPP_DESCRIPTION="Access to a metered streaming session"
MPP_STREAM_UNITS=10

# Native MPP session over a Tempo payment channel.
# Use funded Tempo testnet accounts for the server payee and local demo payer.
TEMPO_SERVER_PRIVATE_KEY=0xreplace_with_64_hex_characters
TEMPO_PAYER_PRIVATE_KEY=0xreplace_with_64_hex_characters
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
TEMPO_CURRENCY=0x20c0000000000000000000000000000000000000
TEMPO_UNIT_AMOUNT=0.0001
TEMPO_SUGGESTED_DEPOSIT=0.01
TEMPO_MAX_DEPOSIT=0.01

# Fastly Fanout publishing. Leave blank for local Pushpin.
# For a deployed service, set the Fastly service ID and an API token that can publish.
FANOUT_SERVICE_ID=
FASTLY_API_TOKEN=
